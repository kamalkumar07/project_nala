{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NalaV1RiskResponse",
  "description": "Frozen NALA V1.0 Dual-Hazard Risk Assessment Contract for Himachal Pradesh",
  "type": "object",
  "required": [
    "location",
    "flood",
    "landslide",
    "modelVersion",
    "modelStatus"
  ],
  "properties": {
    "location": {
      "type": "object",
      "required": ["latitude", "longitude", "district"],
      "properties": {
        "latitude": {
          "type": "number",
          "minimum": -90.0,
          "maximum": 90.0
        },
        "longitude": {
          "type": "number",
          "minimum": -180.0,
          "maximum": 180.0
        },
        "district": {
          "type": "string",
          "description": "Identified administrative district or 'Outside_Himachal_Pradesh'"
        }
      },
      "additionalProperties": false
    },
    "flood": {
      "type": "object",
      "required": [
        "score",
        "band",
        "confidence",
        "assessmentStatus",
        "water_depth",
        "passability",
        "routePassability",
        "evidenceStatus",
        "factors"
      ],
      "properties": {
        "score": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Relative flood hazard index"
        },
        "band": {
          "type": "string",
          "enum": ["LOW", "MEDIUM", "HIGH"]
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Observational data completeness score"
        },
        "assessmentStatus": {
          "type": "string",
          "enum": ["ASSESSED", "INSUFFICIENT_DATA"]
        },
        "water_depth": {
          "type": "string",
          "enum": ["NONE", "ANKLE", "KNEE", "WAIST", "ABOVE_WAIST", "UNKNOWN"],
          "description": "Diagnostic water depth level"
        },
        "passability": {
          "type": "string",
          "enum": ["passable", "not passable", "undetermined"],
          "description": "Diagnostic water level passability directive"
        },
        "routePassability": {
          "type": "string",
          "enum": ["UNDETERMINED"],
          "description": "Authoritative travel safety policy (strictly UNDETERMINED in V1)"
        },
        "evidenceStatus": {
          "type": "object",
          "required": ["valley_slope", "floodplain_tri", "rain_1d", "rain_3d"],
          "properties": {
            "valley_slope": { "type": "string", "enum": ["AVAILABLE", "MISSING", "UNKNOWN", "INVALID"] },
            "floodplain_tri": { "type": "string", "enum": ["AVAILABLE", "MISSING", "UNKNOWN", "INVALID"] },
            "rain_1d": { "type": "string", "enum": ["AVAILABLE", "MISSING", "UNKNOWN", "INVALID"] },
            "rain_3d": { "type": "string", "enum": ["AVAILABLE", "MISSING", "UNKNOWN", "INVALID"] }
          },
          "additionalProperties": false
        },
        "factors": {
          "type": "object",
          "description": "Normalized factor contributions present when AVAILABLE",
          "additionalProperties": { "type": "number" }
        }
      },
      "additionalProperties": false
    },
    "landslide": {
      "type": "object",
      "required": [
        "score",
        "band",
        "confidence",
        "assessmentStatus",
        "evidenceStatus",
        "factors"
      ],
      "properties": {
        "score": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Relative landslide hazard index"
        },
        "band": {
          "type": "string",
          "enum": ["LOW", "MEDIUM", "HIGH"]
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Observational data completeness score"
        },
        "assessmentStatus": {
          "type": "string",
          "enum": ["ASSESSED", "INSUFFICIENT_DATA"]
        },
        "evidenceStatus": {
          "type": "object",
          "required": ["slope", "tri", "rain_1d", "rain_3d"],
          "properties": {
            "slope": { "type": "string", "enum": ["AVAILABLE", "MISSING", "UNKNOWN", "INVALID"] },
            "tri": { "type": "string", "enum": ["AVAILABLE", "MISSING", "UNKNOWN", "INVALID"] },
            "rain_1d": { "type": "string", "enum": ["AVAILABLE", "MISSING", "UNKNOWN", "INVALID"] },
            "rain_3d": { "type": "string", "enum": ["AVAILABLE", "MISSING", "UNKNOWN", "INVALID"] }
          },
          "additionalProperties": false
        },
        "factors": {
          "type": "object",
          "description": "Normalized factor contributions present when AVAILABLE",
          "additionalProperties": { "type": "number" }
        }
      },
      "additionalProperties": false
    },
    "modelVersion": {
      "type": "string",
      "const": "V1.0"
    },
    "modelStatus": {
      "type": "string",
      "const": "PROVISIONAL"
    }
  },
  "additionalProperties": false
}

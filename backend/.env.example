# ──────────────────────────────────────────────────────────────────────────────
# Nala Watch backend — environment variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to the repository.
# ──────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=8080

# Set to true during development / before Handoff 4.
# When true, all service calls use seed data from src/mocks/.
# When false, CLOUD_API_BASE_URL and CLOUD_API_KEY are required.
USE_MOCK=true

# ── Cloud API (Kamal) — required when USE_MOCK=false or any REAL_* flag is true ─
CLOUD_API_BASE_URL=https://wlsar6ezkg.execute-api.ap-south-1.amazonaws.com/dev
CLOUD_API_KEY=REPLACE_WITH_API_GATEWAY_KEY
CLOUD_API_TIMEOUT_MS=8000

# ── Per-feature flags — mix real and mock during rollout ─────────────────────
# Set to true independently to route that function to the real Cloud API.
# CLOUD_API_BASE_URL and CLOUD_API_KEY must be set whenever any flag is true.
REAL_PRESIGN=false
REAL_REPORTS=false
REAL_CONFIRM=false
# Flip to true once Kamal delivers GET /cloud/hotspots
REAL_HOTSPOTS=false

# ── AWS / Cognito — required when USE_MOCK=false ─────────────────────────────
AWS_REGION=ap-south-1
COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXXX
COGNITO_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173

# ── Upload limits ─────────────────────────────────────────────────────────────
MAX_UPLOAD_BYTES=5242880

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info

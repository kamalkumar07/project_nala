# ──────────────────────────────────────────────────────────────────────────────
# PARVAT frontend — Vite environment variables
# Copy this file to .env.local and fill in real values.
# Only VITE_* variables are exposed to the browser bundle.
# NEVER put private keys or secrets here.
# ──────────────────────────────────────────────────────────────────────────────

# Base URL for the Express backend API.
# Leave empty ("") to use the same origin (works with the Vite proxy and
# with CloudFront path-based routing in production).
# Set to http://localhost:8080 if you want to hit the backend directly
# without the Vite proxy.
VITE_API_BASE_URL=

# AWS region (used by Amplify Auth when Cognito is wired up)
VITE_AWS_REGION=ap-south-1

# Cognito — public values only (no client secret)
VITE_COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX

# Amazon Location Service — map tile configuration
VITE_LOCATION_MAP_NAME=NalaWatchMap
VITE_LOCATION_API_KEY=REPLACE_WITH_RESTRICTED_LOCATION_API_KEY

# Ward officer auth mode.
# Set to "false" when USE_MOCK=false on the backend and real Cognito tokens
# are in use. When "true" (default) the login screen shows the quick-login
# button and accepts any non-empty token string.
VITE_USE_MOCK_AUTH=true
